    "@cloudflare/workers-types": "^5.20260801.1",
    "@huyab/config": "github:nguyenhuy158/kit#v0.2.0&path:packages/config",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.156.2"
  },
  "packageManager": "pnpm@10.26.2"
